{
  "name": "Cruddur Configuration",
  "image": "mcr.microsoft.com/devcontainers/universal:2",

  "postCreateCommand": "bash .devcontainer/setup.sh",

  "forwardPorts": [3000, 4567, 2000],
  "portsAttributes": {
    "3000": {
      "label": "frontend",
      "onAutoForward": "openBrowser"
    },
    "4567": {
      "label": "backend"
    },
    "2000": {
      "label": "xray-daemon"
    }
  },

  "remoteUser": "vscode"
}